<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Une seule adresse par page, en un seul saut : domaine nu -> www
    # (portails), puis http -> https (portails et books). Le challenge
    # ACME (certificats) reste joignable en http.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^(ultra-book\.com|dustfolio\.com)$ [NC]
    RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # /index.php demande explicitement : doublon de la racine.
    RewriteCond %{THE_REQUEST} \s/index\.php[/?\s]
    RewriteRule ^index\.php/?(.*)$ /$1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Cache navigateur des fichiers statiques (Apache / O2switch ; Valet,
# nginx, ignore ce fichier). Les pages Laravel gardent leur
# « no-cache, private » : seuls les fichiers servis tels quels sont vises.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 month"
    ExpiresByType application/javascript   "access plus 1 month"
    ExpiresByType text/javascript          "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/gif                "access plus 1 month"
    ExpiresByType image/webp               "access plus 1 month"
    ExpiresByType image/x-icon             "access plus 1 month"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/ttf                 "access plus 1 year"
</IfModule>

# Fichiers de Vite : leur nom change a chaque build, ils ne bougent jamais.
<IfModule mod_headers.c>
    # HTTPS impose au navigateur (sans includeSubDomains : prudence).
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    <If "%{REQUEST_URI} =~ m#^/build/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
