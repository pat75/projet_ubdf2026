# Configuration du deploiement O2switch (ultra-book.pro).
# Copier en "deploy.config" (ignore par git) et renseigner.

# Alias de ~/.ssh/config : il porte HostName, User et la cle
# (IdentityFile ~/.ssh/id_ed25519_o2switch, IdentitiesOnly yes).
SSH_HOST="o2switch-ubpro"
SSH_USER=""                                   # vide : pris dans l'alias
SSH_PORT="22"

# Racine de l'application (contient artisan). Chemin absolu, pas de ~.
REMOTE_PATH="/home/<compte>/ultra-book-pro"

# PHP 8.3 et composer cote serveur (le php par defaut n'est pas 8.3).
REMOTE_PHP="/opt/alt/php83/usr/bin/php"
REMOTE_COMPOSER="\$HOME/composer.phar"

# Sauvegardes (code + base) sur le serveur, et nombre a conserver.
BACKUP_DIR="\$HOME/backups_deploy"
KEEP=5

# Cote poste.
LOCAL_PHP="/usr/local/opt/php@8.3/bin/php"
DEPLOY_BRANCH="book-alpine"                   # vide : pas de controle de branche

# Verification apres deploiement : URL attendues en 200 (separees par un espace).
URL_CHECK="https://www.ultra-book.pro https://<login-test>.ultra-book.pro"
NOINDEX_CHECK=1                               # 1 : exige l'en-tete X-Robots-Tag (recette)
